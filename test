@font-face {
  font-family: 'contb';
  src: url('https://static.wfonts.com/data/2015/10/06/continuum/contb.ttf') format('truetype');
  font-display: swap;
}

/* apply continuum bold font across discord mobile UI */
*, 
[class*="text-"], 
[class*="messageContent-"],
[class*="username-"] {
  font-family: 'contb', system-ui, -apple-system, sans-serif !important;
}
